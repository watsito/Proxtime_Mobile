{
  "expo": {
    "name": "ProxTime",
    "slug": "james-cahyadi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-proxsis.jpeg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon-proxsis.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "scheme": "proxtime",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "ProxTime memerlukan akses kamera untuk mengambil foto selfie saat absen."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ProxTime memerlukan akses lokasi GPS untuk verifikasi geofencing saat absen."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.proxsis.proxtime",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-proxsis.jpeg",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.proxsis.proxtime"
    },
    "web": {
      "favicon": "./assets/icon-proxsis.jpeg"
    },
    "extra": {
      "eas": {
        "projectId": "93467a8c-a9ef-4c1c-8d8c-30f56a4128cb"
      }
    },
    "owner": "jamescahyadis-team"
  }
}
